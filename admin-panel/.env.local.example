# Copy to .env.local for local dev. On Fly.io, set these with `fly secrets set`.

# Same Supabase Postgres URI the backend uses
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Random long string for signing login cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# First GPT Lab super admin (created automatically if none exists)
SUPER_ADMIN_EMAIL=admin@gptlab.dev
SUPER_ADMIN_PASSWORD=change-me-strong-password

# Required on Fly to upload company logos and coach images (Supabase Storage)
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Create public buckets: company-logos and coach-images

# Backend API (diagnostics). Local default is http://127.0.0.1:8000
# On Fly: https://opas-api.fly.dev
BACKEND_URL=http://127.0.0.1:8000

# Email invites when an admin creates a staff or coach login (Resend)
# Only the API key is a server secret. The From address is set per company in Settings.
# RESEND_API_KEY=re_xxxxxxxx
# APP_BASE_URL=https://opas-admin.fly.dev
