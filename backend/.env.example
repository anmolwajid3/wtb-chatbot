# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM access via OpenRouter (OpenAI-compatible API proxying Claude models) ---
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Check https://openrouter.ai/models for the current exact Claude model identifier,
# typically formatted like "anthropic/claude-<version>"
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# --- Database (Supabase-hosted Postgres) ---
# Get this from: Supabase dashboard -> Project Settings -> Database -> Connection string (URI, direct connection)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Observability ---
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
